  "lists": [
    {
      "id": "courses", "title": "Classes", "noun": "Class", "max": 100,
      "hint": "Paste your transcript to fill these in, then check each row. GPA points is what the class counts for in your GPA (for example 5.0 for an A in AP).",
      "fields": [
        {"id": "name", "label": "Class name", "type": "text"},
        {"id": "level", "label": "Level", "type": "choice", "options": ["Regular", "Honors", "Advanced", "Pre-AP", "AP", "IB", "Dual enrollment", "College course", "Other"]},
        {"id": "grade_level", "label": "Grade taken", "type": "choice", "options": ["8th grade", "9th grade", "10th grade", "11th grade", "12th grade"]},
        {"id": "term", "label": "Term", "type": "text", "placeholder": "e.g. Full year, Semester 1, 2025-26"},
        {"id": "grade", "label": "Final grade", "type": "text", "placeholder": "e.g. A-, 94, P"},
        {"id": "credits", "label": "Credits", "type": "number", "min": 0, "max": 10, "decimals": 3},
        {"id": "gpa_points", "label": "GPA points", "type": "number", "min": 0, "max": 12, "decimals": 3},
        {"id": "status", "label": "Status", "type": "choice", "options": ["Completed", "In progress", "Planned"]}
