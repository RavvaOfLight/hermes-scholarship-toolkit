        {"id": "organization", "label": "Organization", "type": "text"},
        {"id": "grades", "label": "Grades participated", "type": "text", "placeholder": "e.g. 10, 11, 12"},
        {"id": "hours_per_week", "label": "Hours per week", "type": "number", "min": 0, "max": 168, "decimals": 1},
        {"id": "weeks_per_year", "label": "Weeks per year", "type": "integer", "min": 0, "max": 52},
        {"id": "description", "label": "Short description", "type": "longtext", "maxlength": 1000}
