    {
      "id": "awards", "title": "Honors & awards", "noun": "Award", "max": 12,
      "fields": [
        {"id": "name", "label": "Award name", "type": "text"},
        {"id": "level", "label": "Level", "type": "choice", "options": ["School", "Local", "Regional", "State", "National", "International"]},
        {"id": "grade", "label": "Grade received", "type": "text", "placeholder": "e.g. 11"}
      ]
    },
    {
      "id": "work", "title": "Jobs", "noun": "Job", "max": 8,
      "fields": [
        {"id": "employer", "label": "Employer", "type": "text"},
        {"id": "title", "label": "Job title", "type": "text"},
        {"id": "start", "label": "Start (month and year)", "type": "month"},
        {"id": "end", "label": "End (month and year, blank if current)", "type": "month"},
        {"id": "hours_per_week", "label": "Hours per week", "type": "number", "min": 0, "max": 168, "decimals": 1},
        {"id": "description", "label": "Short description", "type": "longtext", "maxlength": 1000}
      ]
    },
    {
      "id": "recommenders", "title": "Recommenders", "noun": "Recommender", "max": 6,
      "fields": [
        {"id": "first_name", "label": "First name", "type": "name"},
        {"id": "last_name", "label": "Last name", "type": "name"},
        {"id": "title", "label": "Title or position", "type": "text", "placeholder": "e.g. AP Physics teacher"},
        {"id": "relationship", "label": "How they know you", "type": "text"},
        {"id": "email", "label": "Email", "type": "email"},
        {"id": "phone", "label": "Phone", "type": "phone"}
      ]
    },
    {
      "id": "custom", "title": "Other saved answers", "noun": "Answer", "max": 40,
      "hint": "Anything else forms ask for, like a student ID. Fill these by choosing them and clicking the box.",
      "fields": [
        {"id": "label", "label": "Question or box name", "type": "text"},
        {"id": "value", "label": "Answer", "type": "text"},
        {"id": "also", "label": "Other names for it (comma separated)", "type": "text"}
      ]
